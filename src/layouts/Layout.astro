---
import "../styles/tailwind.css";
import "../styles/fonts.css";
import "../styles/site.css";

export interface Props {
  title: string;
  bodyClass?: string;
  description?: string;
}

const {
  title,
  bodyClass,
  description = "Kevin Wu’s personal site.",
} = Astro.props as Props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content="Kevin Wu" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/newsreader/newsreader-latin-normal-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      async
      defer
      data-domain="kevinniuwu.com"
      src="https://data.kev3u.com/js/pa.js"
    ></script>

    <slot name="head" />
  </head>

  <body class={bodyClass || ""}>
    <slot />
  </body>
</html>
