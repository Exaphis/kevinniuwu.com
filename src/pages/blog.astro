---
import BlogHomeLayout from "../layouts/BlogHomeLayout.astro";
import PostList from "../components/PostList.astro";
import { posts } from "../data/posts";
const years = [
  ...new Set(posts.map((post) => post.frontmatter.date.slice(0, 4))),
];
---

<BlogHomeLayout>
  {years.map((year) => (
    <section class="archive-year" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`}>{year}</h2>
      <PostList
        posts={posts.filter((post) => post.frontmatter.date.startsWith(year))}
      />
    </section>
  ))}
</BlogHomeLayout>
